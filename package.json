{
  "name": "dsh-capability-router",
  "version": "0.2.0",
  "description": "让 agent 在动手之前先问清需求、再确认手上能力够不够；后续负责按任务收窄技能目录、按角色请专家。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check lib/index.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "skill-router",
    "agent",
    "prompt"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0",
      "profiles": [
        "desktop",
        "web"
      ]
    }
  }
}
